---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  page: 'index' | 'impressum';
  title?: string;
}

const {
  page,
  title = 'Lizaveta Kukharava, a Berlin-based UX Designer',
} = Astro.props;
const stylesheets = page === 'index'
  ? ['style.css', 'css/index.css', 'css/about.css', 'css/work.css']
  : ['style.css', 'css/impressum.css'];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="Logo.svg" type="image/svg+xml">
  <title>{title}</title>
  <meta name="description" content="If you care for your customers and users as much as I do, take a look at my portfolio and reach out to team up and transform your challenges into wins.">
  {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
</head>
<body>
  <Header />
  <slot />
  <Footer isImpressum={page === 'impressum'} />
  {page === 'index' && <script is:inline src="scroll-nav.js"></script>}
</body>
</html>
