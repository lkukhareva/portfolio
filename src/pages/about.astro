---
// Old URL. ./#about resolves to /#about at the domain root and /portfolio/#about on Pages.
const target = './#about';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lizaveta Kukharava, a Berlin-based UX Designer</title>
  <link rel="canonical" href={target}>
  <meta http-equiv="refresh" content={`0; url=${target}`}>
  <script is:inline>location.replace("./#about")</script>
</head>
<body>
  <p><a href={target}>About</a></p>
</body>
</html>
