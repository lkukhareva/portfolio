---
const softSkills = ['Communication', 'Active Listening', 'Attention to Detail', 'Problem Solving', 'Presentation Skills'];
const craftSkills = ['UX Research', 'Wireframing & Prototyping', 'Content Design', 'Coding Basics', 'Analytical Thinking'];

// Chronological: teaching, then the IT company, then UX.
const stories = [
  {
    image: 'classroom.webp', width: 1100, height: 674,
    alt: 'A coding class in the ReDI School Kids program',
    caption: 'Volunteering at ReDI School’s coding classes for kids',
    title: 'Empathy and communication',
    text: 'I first studied language teaching and interpreting. Working with kids, I learned to communicate clearly, give feedback, and help them understand new ideas. This experience honed my empathy and communication, which are crucial in UX design.',
  },
  {
    image: 'andersenoffice.jpg', width: 800, height: 534,
    alt: 'Andersen lab office',
    caption: 'Andersen lab office. Photo: Anastasia Andreyko on LinkedIn',
    title: 'Growth and improvement',
    text: 'Seeking independence and market experience, I joined an IT company as a Customer Acquisition Specialist. I grew with the company, explored different parts of the IT process, and improved my department’s performance while continuously developing my own skills. My experience and empathy led me to a Team Lead position.',
  },
  {
    image: 'Laptop.webp', width: 1100, height: 810,
    alt: 'Designing an app at home',
    caption: 'Designing my very first app at home',
    title: 'Going the extra mile',
    text: 'Realizing I could do more for customers and help solve their problems, I dived into the UX field. I immersed myself in the design process, understanding the importance of research and communication, and created my first app prototypes. This journey has been about constant learning and growth, driving me to create better user experiences every day.',
  },
];
---

<section id="about" class="about container" aria-label="About">
  <div class="about-intro">
    <img loading="lazy" src="profile.webp" alt="Lizaveta Kukharava" width="900" height="1098" class="about-portrait">
    <div class="quotes">
      <blockquote class="quote">
        “Lizaveta is tactful in communicating with clients and colleagues,
        non-conflict, sociable, knows how to work in a team.”
      </blockquote>
      <blockquote class="quote">
        “She displayed strong professionalism, patience with others and
        desire to share her knowledge with the team.”
      </blockquote>
      <blockquote class="quote">
        “Liza was a pleasure to work with, she's easygoing, smart and a very
        responsible worker. She's always focused and determined and isn't
        afraid to dive into details.”
      </blockquote>
    </div>
  </div>

  <div class="section-label">
    <h2>What I bring to the table</h2>
    <img src="assets/section-arrow.svg" alt="">
  </div>
  <div class="strengths">
    <div class="strengths-text">
      <p>
        Known for my easy-going nature, non-confrontational attitude, and can-do
        spirit, I bring a high level of responsibility and an eagerness to
        explore new horizons and share insights.
      </p>
      <p>
        My interest in UX design was sparked by the realization that my
        interaction with customers as a Customer Acquisition Specialist
        could extend beyond understanding their pain points to actively
        providing solutions.
      </p>
    </div>
    <div class="skills">
      <div class="skill-group">
        <h3 class="skill-heading">Soft skills</h3>
        <!-- [html-validate-disable-next no-redundant-role -- WebKit drops list semantics with list-style: none] -->
        <ul class="skill-list" role="list">
          {softSkills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <div class="skill-group">
        <h3 class="skill-heading">Hard skills</h3>
        <!-- [html-validate-disable-next no-redundant-role -- WebKit drops list semantics with list-style: none] -->
        <ul class="skill-list" role="list">
          {craftSkills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>
  </div>

  {stories.map((story) => (
    <article class="story">
      <figure class="story-media">
        <img loading="lazy" src={story.image} alt={story.alt} width={story.width} height={story.height} class="story-image">
        <figcaption class="story-caption">{story.caption}</figcaption>
      </figure>
      <div class="story-body">
        <h2 class="story-title">{story.title}</h2>
        <p class="story-text">{story.text}</p>
      </div>
    </article>
  ))}
</section>
