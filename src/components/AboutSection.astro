---
const softSkills = ['Communication', 'Active Listening', 'Attention to Detail', 'Problem Solving', 'Presentation Skills'];
const craftSkills = ['UX Research', 'Wireframing & Prototyping', 'Content Design', 'Coding basics', 'Analytical thinking'];

const stories = [
  {
    image: 'andersenoffice.jpg', width: 800, height: 534,
    alt: 'Andersen lab office',
    caption: 'Andersen lab office. Credits: Anastasia Andreyko on LinkedIn',
    title: 'Growth and improvement',
    text: 'Seeking independence and market experience, I joined an IT company as a Customer Acquisition Specialist. I grew together with the company, exploring various aspects of the IT process and improving departmental performance by continuously improving myself. My experience and empathy naturally led me to a Team Lead position.',
  },
  {
    image: 'classroom.webp', width: 1100, height: 674,
    alt: 'Coding classes at ReDI School Kids program',
    caption: 'Volunteering for the coding classes at ReDI School Kids program',
    title: 'Empathy and communication',
    text: 'Initially I pursued a degree in language teaching and interpreting. During working with kids, I learned how to communicate clearly, provide feedback, and support children seeking understanding. This experience honed my skills in empathy and communication, which are crucial in UX design.',
  },
  {
    image: 'Laptop.webp', width: 1100, height: 810,
    alt: 'Designing an app at home',
    caption: 'Designing my very first app at home',
    title: 'Going extra mile',
    text: 'Realising I could do more for customers and help solve their problems, I dived into the UX field. I immersed myself in the design process, understanding the importance of research and communication, and created my first app prototypes. This journey has been about constant learning and growth, driving me to create better user experiences every day.',
  },
];
---

<section id="about" class="about container" aria-label="About">
  <div class="quotes">
    <blockquote class="quote">
      &quot;Lizaveta is tactful in communicating with clients and colleagues,
      non-conflict, sociable, knows how to work in a team.&quot;
    </blockquote>
    <blockquote class="quote">
      &quot;She displayed strong professionalism, patience with others and
      desire to share her knowledge with the team.&quot;
    </blockquote>
    <blockquote class="quote">
      “Liza was a pleasure to work with, she's easygoing, smart and a very
      responsible worker. She's always focused and determined and isn't
      afraid to dive into details.”
    </blockquote>
  </div>

  <div class="section-label">
    <h2>what i bring to the table</h2>
    <img src="assets/section-arrow.svg" alt="">
  </div>
  <div class="strengths">
    <div class="strengths-text">
      <p>
        Known for my easy-going nature, non-conflict attitude, and can-do
        spirit, I bring a high level of responsibility and an eagerness to
        explore new horizons and share insights.
      </p>
      <p>
        My interest in UX design was sparked by the realization that my
        interaction with customers as a Customer Acquisition Specialist
        could extend beyond understanding their pain points to actively
        providing solutions.
      </p>
    </div>
    <div class="skills">
      <!-- [html-validate-disable-next no-redundant-role -- WebKit drops list semantics with list-style: none] -->
      <ul class="skill-list" role="list">
        {softSkills.map((skill) => <li>{skill}</li>)}
      </ul>
      <!-- [html-validate-disable-next no-redundant-role -- WebKit drops list semantics with list-style: none] -->
      <ul class="skill-list" role="list">
        {craftSkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </div>

  {stories.map((story) => (
    <article class="story">
      <figure class="story-media">
        <img loading="lazy" src={story.image} alt={story.alt} width={story.width} height={story.height} class="story-image">
        <figcaption class="story-caption">{story.caption}</figcaption>
      </figure>
      <div class="story-body">
        <h2 class="story-title">{story.title}</h2>
        <p class="story-text">{story.text}</p>
      </div>
    </article>
  ))}

  <p class="about-contact">
    Reach out to <a href="mailto:contact@lizaveta.co">contact@lizaveta.co</a> to team up and transform your challenges into wins.
  </p>
</section>
