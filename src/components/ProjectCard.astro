---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  loading?: 'lazy';
}

const { project, loading } = Astro.props;
---

<a href={project.href} class="project-card" target="_blank" rel="noopener">
  <img loading={loading} src={project.image} alt="" width="1100" height="782" class="project-image">
  <div class="project-body">
    <h3 class="project-title">{project.title}</h3>
    <p class="project-description">{project.description}</p>
  </div>
</a>
