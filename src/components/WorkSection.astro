---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const ordered = (['fashion', 'hop', 'cloud', 'rapuha'] as const).map((key) => [key, projects[key]] as const);
---

<section id="work" class="work container" aria-label="Work">
  <div class="section-label">
    <h2>Recent projects</h2>
    <img src="assets/section-arrow.svg" alt="">
  </div>
  <div class="project-grid">
    {ordered.map(([key, project], index) => (
      <ProjectCard project={project} id={`project-${key}`} loading={index < 2 ? undefined : 'lazy'} />
    ))}
  </div>

  <p class="work-contact">
    Reach out to <a href="mailto:contact@lizavetakuk.com">contact@<wbr>lizavetakuk.com</a> to&nbsp;team&nbsp;up and transform your challenges into wins.
  </p>
</section>
