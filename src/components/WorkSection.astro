---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section id="work" aria-label="Work">
  <div class="div">
    <div class="section-label">
      <h2>RECENT PROJECTS</h2>
      <img src="assets/section-arrow.svg" alt="">
    </div>
    <ProjectCard project={projects.fashion} classes={{
      link: 'div-8', row: 'div-9', column: 'column-2',
      content: 'div-10', title: 'div-11', description: 'div-12',
    }} />
    <ProjectCard project={projects.hop} loading="lazy" classes={{
      link: 'div-13', row: 'div-14', column: 'column-3',
      content: 'div-15', title: 'div-16', description: 'div-17',
    }} />
    <ProjectCard project={projects.cloud} loading="lazy" classes={{
      link: 'div-18', row: 'div-19', column: 'column-4',
      content: 'div-20', title: 'div-21', description: 'div-22',
    }} />
    <ProjectCard project={projects.rapuha} loading="lazy" classes={{
      link: 'div-23', row: 'div-24', column: 'column-5',
      content: 'div-25', title: 'div-26', description: 'div-27',
    }} />
  </div>
</section>
